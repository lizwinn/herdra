// Herdr's classic keymap: every action one key after the prefix.
//
// Select it with `base classic` in your keymap.kdl. It matches Herdr's
// keybindings before the keymap tree existed, including navigate mode
// falling back to prefix keys.

prefix prefix id=prefix {
    esc menu.cancel
    prefix menu.literal

    "?" keybinds view=help id=help {
        "/" help.filter
        j help.scroll.down scroll
        k help.scroll.up scroll
        up help.scroll.up scroll
        down help.scroll.down scroll
        pageup help.page.up scroll
        pagedown help.page.down scroll
        home help.top hidden
        end help.bottom hidden
        enter help.close
        "?" help.close hidden
        esc help.close
    }

    s settings hidden view=settings id=settings {
        up settings.choice.up select
        down settings.choice.down select
        k settings.choice.up hidden
        j settings.choice.down hidden
        tab settings.section.next section
        right settings.section.next hidden
        l settings.section.next hidden
        shift+tab settings.section.previous hidden
        left settings.section.previous hidden
        shift+left settings.section.previous hidden
        h settings.section.previous hidden
        enter settings.apply hidden
        space settings.apply hidden
        esc settings.close hidden
    }

    q app.detach hidden
    R app.reload hidden
    o agent.notification hidden

    g navigator hidden view=navigator id=navigator {
        up navigator.move.up rows
        down navigator.move.down rows
        j navigator.move.down rows
        k navigator.move.up rows
        ctrl+u navigator.page.up hidden
        ctrl+d navigator.page.down hidden
        home navigator.top hidden
        end navigator.bottom hidden
        G navigator.bottom hidden
        left navigator.section.previous workspace
        right navigator.section.next workspace
        "/" navigator.search
        a navigator.filter.all filter
        b navigator.filter.blocked filter
        w navigator.filter.working filter
        i navigator.filter.idle filter
        d navigator.filter.done filter
        backspace navigator.filter.clear hidden
        enter navigator.open
        esc navigator.close
    }

    N workspace.new hidden
    G worktree.new hidden
    W workspace.rename hidden
    D workspace.close hidden
    c tab.new hidden
    T tab.rename hidden
    p tab.previous hidden
    n tab.next hidden
    "1..9" tab.switch hidden
    X tab.close hidden
    P pane.rename hidden
    e pane.scrollback hidden
    h pane.focus.left hidden
    j pane.focus.down hidden
    k pane.focus.up hidden
    l pane.focus.right hidden
    H pane.swap.left hidden
    J pane.swap.down hidden
    K pane.swap.up hidden
    L pane.swap.right hidden
    tab pane.cycle.next hidden
    shift+tab pane.cycle.previous hidden
    v pane.split.right hidden
    "-" pane.split.down hidden
    x pane.close hidden
    z pane.zoom hidden
    b app.sidebar hidden

    // Navigate mode: keys it does not bind fall through to the prefix menu,
    // so your prefix keys (and your changes to them) work here too.
    w navigate hint="workspace nav" view=workspace-list unmatched=ignore fallthrough id=navigate {
        esc menu.cancel back
        prefix menu.cancel hidden
        up workspace.list.up workspace stay
        down workspace.list.down workspace stay
        enter workspace.list.open hidden
        "1..9" workspace.switch hidden
        tab pane.cycle.next pane
        shift+tab pane.cycle.previous hidden
        h pane.focus.left hidden stay
        j pane.focus.down hidden stay
        k pane.focus.up hidden stay
        l pane.focus.right hidden stay
        left pane.focus.left hidden stay
        right pane.focus.right hidden stay
        w menu.cancel hidden
    }

    r resize sticky hidden id=resize {
        esc menu.cancel done
        h pane.resize.left width
        l pane.resize.right width
        j pane.resize.down height
        k pane.resize.up height
        left pane.resize.left hidden
        right pane.resize.right hidden
        down pane.resize.down hidden
        up pane.resize.up hidden
        shift+left pane.resize.left hidden
        shift+right pane.resize.right hidden
        shift+down pane.resize.down hidden
        shift+up pane.resize.up hidden
        enter menu.cancel hidden
        r menu.cancel hidden
    }

    "[" copy mode hidden view=copy id=copy {
        esc copy.escape
        h copy.move.left hidden
        j copy.move.down hidden
        k copy.move.up hidden
        l copy.move.right hidden
        left copy.move.left hidden
        down copy.move.down hidden
        up copy.move.up hidden
        right copy.move.right hidden
        w copy.word.next hidden
        b copy.word.previous hidden
        e copy.word.end hidden
        W copy.bigword.next hidden
        B copy.bigword.previous hidden
        E copy.bigword.end hidden
        "{" copy.paragraph.previous hidden
        "}" copy.paragraph.next hidden
        "0" copy.line.start hidden
        home copy.line.start hidden
        "$" copy.line.end hidden
        end copy.line.end hidden
        "^" copy.line.first-nonblank hidden
        g copy.history.start hidden
        G copy.history.end hidden
        pageup copy.page.up hidden
        pagedown copy.page.down hidden
        ctrl+f copy.page.down hidden
        ctrl+b copy.page.up hidden
        ctrl+u copy.halfpage.up hidden
        ctrl+d copy.halfpage.down hidden
        "/" copy.search.forward search
        "?" copy.search.backward search
        n copy.search.next repeat
        N copy.search.reverse repeat
        v copy.select select
        space copy.select select
        V copy.select.line hidden
        y copy.yank copy
        enter copy.yank copy
        q copy.exit
    }
}
